# Server-only URL used by the Next.js action; never expose this as NEXT_PUBLIC_API_URL.
API_URL=http://127.0.0.1:8000
# Keyed chat retries are fail-closed and disabled until every backend instance
# supports the ledger contract and capability marker. Enable server-side first.
CHAT_IDEMPOTENCY_ENABLED=false
NEXT_PUBLIC_CHAT_IDEMPOTENCY_ENABLED=false
# Backend must use the same auth cookie name and a finite session TTL.
# The browser cookie is HttpOnly and is bridged by Next.js server actions.
