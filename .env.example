DATABASE_URL=

# Phase-one auth session settings (use ENVIRONMENT=production to enable Secure cookies)
ENVIRONMENT=development
AUTH_SESSION_COOKIE=kelana_session
AUTH_SESSION_TTL_SECONDS=604800

# AWS Configs
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MODEL_ID=

# Openrouter Configs
OPENROUTER_API_KEY = 
OPENROUTER_MODEL = dots-studio/dots-3-note-preview:free

# RAG configuration (the Bedrock Knowledge Base is provisioned out-of-band)
BEDROCK_KNOWLEDGE_BASE_ID=
KNOWLEDGE_BASE_MODEL_ARN=
RAG_ENABLED=true
RAG_CONTEXT_MAX_CHARS=32768
RAG_MAX_CHUNK_CHARS=4096

# Exa live web highlights (optional; leave blank to disable Exa retrieval)
EXA_API_KEY=
EXA_ENABLED=true
EXA_NUM_RESULTS=3
EXA_MAX_HIGHLIGHT_CHARS=1000

# On-demand Base vs RAG comparison endpoint (optional feature flag)
RAG_COMPARISON_ENABLED=false