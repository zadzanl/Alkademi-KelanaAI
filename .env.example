# Required: Neon pooled PostgreSQL URL for the running API.
# Use the direct (non-pooled) URL only for migrations/admin work.
DATABASE_URL=

# Phase-one auth session settings
# Use ENVIRONMENT=production to enable Secure cookies.
ENVIRONMENT=development
AUTH_SESSION_COOKIE=kelana_session
AUTH_SESSION_TTL_SECONDS=604800

# OpenRouter is the recommended initial provider. Both values are required
# together to enable it; otherwise the API gracefully returns no AI narrative.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# Optional Amazon Bedrock fallback. Both AWS_REGION and MODEL_ID are required
# together when OpenRouter is not configured. boto3 resolves credentials from
# the runtime identity or the variables below.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
MODEL_ID=

# Optional RAG configuration. Keep RAG_ENABLED=false for the first deployment
# unless the Bedrock Knowledge Base has been provisioned and verified.
BEDROCK_KNOWLEDGE_BASE_ID=
KNOWLEDGE_BASE_MODEL_ARN=
RAG_ENABLED=false
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.3
RAG_CONTEXT_MAX_CHARS=32768
RAG_MAX_CHUNK_CHARS=4096

# Optional Exa live web highlights. A key and EXA_ENABLED=true are both needed.
EXA_API_KEY=
EXA_ENABLED=false
EXA_NUM_RESULTS=3
EXA_SCORE_THRESHOLD=0.3
EXA_MAX_HIGHLIGHT_CHARS=1000

# Optional comparison endpoint and logging. Keep disabled initially.
RAG_COMPARISON_ENABLED=false
RAG_COMPARISON_LOGGING=false

# Optional AI telemetry logging.
AI_METRICS_ENABLED=false

# Optional destination-place generation and chat context limits.
PLACES_GENERATION_ENABLED=true
MAX_CHAT_CONTEXT_MESSAGES=20

# Optional keyed chat retry ledger. Enable only after its database migration
# has been applied and verified; the frontend copy lives in frontend/.env.example.
CHAT_IDEMPOTENCY_ENABLED=false
